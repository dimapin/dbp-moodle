FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS build
ARG APACHE_VERSION="2.4.66-1~deb12u1"
ARG APACHE_DOWNLOAD_URL="https://snapshot.debian.org/archive/debian/20260131T202859Z/pool/main/a/apache2/"
WORKDIR /
RUN mkdir /bitnami /dbp-moodle /opt/dbp-moodle

COPY scripts/install/apacheInstall.sh /scripts/install/apacheInstall.sh
COPY scripts/init/apache /scripts/init/apache
COPY libraries /scripts

# Add user with ID 1001
RUN useradd moodle -u 1001

RUN chmod -R +x /scripts/

# Base tools: curl (package download), gettext-base (envsubst), openssl (SSL cert generation)
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    curl ca-certificates gettext-base openssl procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Apache2 from the pinned Debian snapshot.
# apt resolves the package dependencies from the distribution repository,
# so no manually maintained library list is required.
RUN apt-get update && \
    curl -fLO ${APACHE_DOWNLOAD_URL}apache2-bin_${APACHE_VERSION}_amd64.deb && \
    curl -fLO ${APACHE_DOWNLOAD_URL}apache2-data_${APACHE_VERSION}_all.deb && \
    curl -fLO ${APACHE_DOWNLOAD_URL}apache2-utils_${APACHE_VERSION}_amd64.deb && \
    curl -fLO ${APACHE_DOWNLOAD_URL}apache2_${APACHE_VERSION}_amd64.deb && \
    apt-get install -y --no-install-recommends \
    ./apache2-bin_${APACHE_VERSION}_amd64.deb \
    ./apache2-data_${APACHE_VERSION}_all.deb \
    ./apache2-utils_${APACHE_VERSION}_amd64.deb \
    ./apache2_${APACHE_VERSION}_amd64.deb && \
    rm -f *.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    # Disable mod_cgid: the PHP-FPM setup uses mod_proxy_fcgi (not CGI daemon).
    # mod_cgid creates a random socket file and tries to chown it on startup,
    # which fails when running as non-root uid 1001 and breaks apache2ctl.
    a2dismod cgid 2>/dev/null || true

COPY scripts/init/apache/httpd.conf /etc/apache2/apache2.conf

RUN /scripts/install/apacheInstall.sh

# Hardening
RUN find / -perm /6000 -type f -exec chmod a-s {} \; || true

RUN apt-get remove -y curl && \
    apt-get autoremove -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/run/apache2 && \
    chmod -R g+w /etc/apache2/ && \
    chown -R 1001:1001 /etc/apache2 /var/log/apache2 /var/run/apache2 /opt/dbp-moodle /dbp-moodle && \
    chown -R 1001:root /scripts

EXPOSE 8080 8443

USER 1001

ENTRYPOINT ["/scripts/init/apache/entrypoint.sh"]
